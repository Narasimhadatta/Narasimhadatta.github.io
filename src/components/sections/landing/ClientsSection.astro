---
// Define props from Astro
const { title, subTitle ,src,alt} = Astro.props;
import { Image } from "astro:assets";
import suraksha from "@images/suraksha-clinic.png";
import samanvaya from "@images/samanvaya.png";
import railway from "@images/railway2.png";
import yucca from "@images/yucca3.png";
import iso from "@images/iso.png";
import msme from "@images/msme.png"

// Define TypeScript interface for props
interface Props {
  title?: string;
  subTitle?: string;
  src?: any;
  alt?: string;
}
---

<section
  class="mx-auto max-w-full px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
>
  <!-- Title and description -->
  <div class="mx-auto mt-5 max-w-full text-center whitespace-nowrap">
    <h2
      class="block text-balance text-xl font-bold leading-tight tracking-tight text-neutral-800 dark:text-neutral-200 md:text-5xl lg:text-5xl"
    >
      {title}
    </h2>
    {
      subTitle && (
        <p class="text-pretty leading-tight text-neutral-600 dark:text-neutral-400">
          {subTitle}
        </p>
      )
    }
  </div>
  <div
    class="flex flex-col items-center justify-center gap-y-2 sm:flex-row sm:gap-x-12 sm:gap-y-0 lg:gap-x-24"
  >
  <div class="relative mb-6 overflow-hidden md:mb-8">
    {
      src && alt && (
        <Image
          src={src}
          alt={alt}
          class="h-full w-full object-cover object-center"
          draggable={"false"}
          format={"png"}
          loading={"eager"}
        />
      )
    }
  </div>
  <div class="relative mb-6 overflow-hidden md:mb-8">
    {
      
        <Image
          src={suraksha}
          alt="suraksha"
          class=" object-cover object-center px-10 py-10"
          draggable={"false"}
          format={"png"}
          loading={"eager"}
        />
      
    }
  </div>
  <div class="relative mb-6 overflow-hidden md:mb-8">
    {
      
        <Image
          src={samanvaya}
          alt="samanvaya"
          class="h-full w-full object-cover object-center px-10 py-10"
          draggable={"false"}
          format={"png"}
          loading={"eager"}
        />
      
    }
  </div>
  <div class="relative mb-6 overflow-hidden md:mb-8">
    {
      
        <Image
          src={railway}
          alt="samanvaya"
          class="img-client object-cover object-center px-10 py-10"
          draggable={"false"}
          format={"png"}
          loading={"eager"}
        />
      
    }
  </div>
  <div class="relative mb-6 overflow-hidden md:mb-8">
    {
      
        <Image
          src={yucca}
          alt="samanvaya"
          class="h-full w-full object-cover object-center px-10 py-10"
          draggable={"false"}
          format={"png"}
          loading={"eager"}
        />
      
    }
  </div>
  
 
</div>  
</section>
<section>
  <div class="mx-auto mt-5 max-w-full text-center whitespace-nowrap">
    <h2
      class="block text-balance text-xl font-bold leading-tight tracking-tight text-neutral-800 dark:text-neutral-200 md:text-5xl lg:text-5xl"
    >
      Certified By
    </h2>
    <div
    class="flex flex-col items-center justify-center gap-y-2 sm:flex-row sm:gap-x-12 sm:gap-y-0 lg:gap-x-2 px-10 py-10"
  >
  
  <div class="relative mb-6 overflow-hidden md:mb-8">
    {
      
      <Image
      src={iso}
      alt="samanvaya"
      class="certificate object-cover object-center  "
      draggable={"false"}
      format={"png"}
      loading={"eager"}
      />
      
    }
    </div>
    <div class="relative mb-6 overflow-hidden md:mb-8">
      {

        <Image
         src={msme}
         alt="samanvaya"
         class="certificate  object-cover object-center px-12 "
         draggable={"false"}
         format={"png"}
        loading={"eager"}
        />
      }
        
        
      
      </div>
    </div>
    </div>
</section>
<style>
  .certificate{
    height: 100%;
    width:100%
  }
  @media (min-width: 1024px) {  /* Adjusting for laptop screens */
  .certificate {
    width: 70%;
    height: 70%;
  }
}

</style>
